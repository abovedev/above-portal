generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PageType {
  GLOBAL
  PERSONAL
}

enum SectionType {
  TEXT
  IMAGE
  VIDEO
  EMBED
  DIVIDER
}

enum WidgetType {
  CLOCK
  WEATHER
  ANNOUNCEMENTS
  QUICK_LINKS
  TASKS
  CALENDAR
  NOTES
  STATS
  SYSTEM_STATS
  RECENT_ACTIVITY
  USER_GROWTH
  PAGE_VIEWS
  GMAIL
  GCHAT
  AI_CHAT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  PAGE_ASSIGNED
  ANNOUNCEMENT
  SYSTEM
  TASK_REMINDER
  MENTION
  GEAR_REQUEST
}

enum GearStatus {
  AVAILABLE
  CHECKED_OUT
  RESERVED
  RETURN_PENDING
  MAINTENANCE
  RETIRED
}

enum GearRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  COLLECTED
}

enum MissingShotStatus {
  NEEDED
  IN_PROGRESS
  CAPTURED
  ARCHIVED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  avatar        String?
  role          Role     @default(USER)
  department    String?
  position      String?
  isActive      Boolean  @default(true)
  googleAccessToken  String?
  googleRefreshToken String?
  googleEmail        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  asanaConnection AsanaConnection?
  widgets       Widget[]
  tasks         Task[]
  quickLinks    QuickLink[]
  notifications Notification[]
  pageAssignments PageAssignment[] @relation("AssignedToUser")
  assignedBy    PageAssignment[]   @relation("AssignedByAdmin")
  pagesCreated  Page[]
  announcements Announcement[]
  comments      AnnouncementComment[]
  reactions     AnnouncementReaction[]
  mentions      AnnouncementMention[]
  updatedAISettings    AiSettings[]      @relation("AISettingsUpdatedBy")
  gearRequests         GearRequest[]     @relation("GearRequester")
  gearReviewedRequests GearRequest[]     @relation("GearReviewer")
  gearAssignmentsUser  GearAssignment[]  @relation("GearAssignee")
  gearAssignmentsAdmin GearAssignment[]  @relation("GearAssigner")
  driveFolders         DriveFolder[]     @relation("FolderAddedBy")
  fileTags             FileTag[]         @relation("FileTaggedBy")
  fileTagPermission    FileTagPermission? @relation("FileTagPermission")
  missingShots         MissingShot[]     @relation("MissingShotRequester")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AsanaConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asanaUserGid   String
  asanaUserName  String?
  asanaUserEmail String?
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  workspaceGid   String?
  workspaceName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Page {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     Json?
  coverImage  String?
  icon        String?
  description String?
  type        PageType  @default(GLOBAL)
  isPublished Boolean   @default(false)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections    PageSection[]
  assignments PageAssignment[]
}

model PageSection {
  id      String      @id @default(cuid())
  pageId  String
  page    Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title   String?
  content Json?
  order   Int
  type    SectionType @default(TEXT)
}

model PageAssignment {
  id           String   @id @default(cuid())
  pageId       String
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation("AssignedToUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("AssignedByAdmin", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([pageId, userId])
}

model Widget {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       WidgetType
  title      String
  settings   Json       @default("{}")
  isVisible  Boolean    @default(true)
  positionX  Int        @default(0)
  positionY  Int        @default(0)
  width      Int        @default(4)
  height     Int        @default(2)
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  priority    Priority  @default(LOW)
  isPinned    Boolean   @default(false)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    AnnouncementComment[]
  reactions   AnnouncementReaction[]
}

model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  mentions       AnnouncementMention[]
}

model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji          String
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId, emoji])
}

model AnnouncementMention {
  id        String              @id @default(cuid())
  commentId String
  comment   AnnouncementComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  read      Boolean             @default(false)
  createdAt DateTime            @default(now())
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  priority    Priority  @default(LOW)
  asanaTaskGid String?
  asanaPermalink String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model QuickLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  url       String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
}

model CompanySettings {
  id           String   @id @default(cuid())
  companyName  String   @default("Above Portal")
  logoUrl      String?
  theme        String   @default("dark")
  accentColor  String   @default("#D7DCE2")
  defaultWidgets Json   @default("[]")
  updatedAt    DateTime @updatedAt
}

model AiSettings {
  id                       String   @id @default("default")
  emailTone                String   @default("Professional")
  defaultEmailInstructions String   @default("Write clear, polite, professional emails. Keep the response concise and easy to understand.")
  writingStyleNotes        String   @default("Use Australian English. Avoid overly technical language unless requested.")
  documentAccessMode       String   @default("NO_DOCUMENT_ACCESS")
  allowedFileTypes         String[] @default([])
  extraSystemInstructions  String   @default("")
  aiAssistantEnabled       Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  updatedByAdminId         String?
  updatedByAdmin           User?    @relation("AISettingsUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
}

model GearItem {
  id             String     @id @default(cuid())
  name           String
  brand          String?
  model          String?
  category       String     @default("Other")
  serialNumber   String?
  imei           String?
  assetTag       String?
  description    String?
  notes          String?
  photo          String?
  purchaseDate   DateTime?
  purchaseCost   Float?
  vendor         String?
  warrantyExpiry DateTime?
  condition      String     @default("Good")
  location       String?
  status         GearStatus @default(AVAILABLE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  requests    GearRequest[]
  assignments GearAssignment[]
}

model GearRequest {
  id           String            @id @default(cuid())
  gearItemId   String
  gearItem     GearItem          @relation(fields: [gearItemId], references: [id], onDelete: Cascade)
  requesterId  String
  requester    User              @relation("GearRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  status       GearRequestStatus @default(PENDING)
  reason       String?
  startDate    DateTime?
  endDate      DateTime?
  adminNote    String?
  reviewedById String?
  reviewedBy   User?             @relation("GearReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model GearAssignment {
  id           String    @id @default(cuid())
  gearItemId   String
  gearItem     GearItem  @relation(fields: [gearItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("GearAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User      @relation("GearAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  checkedOutAt DateTime  @default(now())
  dueDate      DateTime?
  returnedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
}

// ─── File Management System ────────────────────────────────────────────────────

model DriveFolder {
  id         String      @id @default(cuid())
  driveId    String      @unique
  name       String
  url        String?
  driveType  String      @default("personal")
  recursive  Boolean     @default(false)
  isWatched  Boolean     @default(true)
  addedById  String
  addedBy    User        @relation("FolderAddedBy", fields: [addedById], references: [id])
  lastSyncAt DateTime?
  fileCount  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  files      DriveFile[]
}

model DriveFile {
  id             String       @id @default(cuid())
  driveId        String       @unique
  name           String
  mimeType       String
  size           BigInt?
  webViewLink    String
  thumbnailLink  String?
  folderId       String?
  folder         DriveFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  subfolderPath  String?
  nameValid      Boolean      @default(false)
  parsedDate     String?
  parsedSubject  String?
  parsedLocation String?
  nameSuggestion String?
  modifiedAt     DateTime?
  syncedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tags           FileTag[]
  resolvedShots  MissingShot[]
}

model TagCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  color     String     @default("#6366f1")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  values    TagValue[]
}

model TagValue {
  id         String      @id @default(cuid())
  categoryId String
  category   TagCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  value      String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  files      FileTag[]
  @@unique([categoryId, value])
}

model FileTag {
  id         String    @id @default(cuid())
  fileId     String
  file       DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tagValueId String
  tagValue   TagValue  @relation(fields: [tagValueId], references: [id], onDelete: Cascade)
  taggedById String
  taggedBy   User      @relation("FileTaggedBy", fields: [taggedById], references: [id])
  createdAt  DateTime  @default(now())
  @@unique([fileId, tagValueId])
}

model FileTagPermission {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("FileTagPermission", fields: [userId], references: [id], onDelete: Cascade)
  canTag    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MissingShot {
  id              String            @id @default(cuid())
  subject         String
  description     String?
  vehicleMake     String?
  packageType     String?
  category        String?
  feature         String?
  priority        Priority          @default(MEDIUM)
  status          MissingShotStatus @default(NEEDED)
  requestedById   String
  requestedBy     User              @relation("MissingShotRequester", fields: [requestedById], references: [id])
  targetShootDate DateTime?
  resolvedFileId  String?
  resolvedFile    DriveFile?        @relation(fields: [resolvedFileId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}
